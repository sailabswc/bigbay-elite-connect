{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "swim_type": {
      "type": "string",
      "enum": [
        "channel_crossing",
        "round_island",
        "coastal_dash",
        "bay_swim",
        "training_camp",
        "adventure_swim"
      ],
      "default": "bay_swim"
    },
    "description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "distance_km": {
      "type": "number"
    },
    "start_point": {
      "type": "string"
    },
    "end_point": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "default": "Western Cape"
    },
    "water_temp_c": {
      "type": "number"
    },
    "expected_conditions": {
      "type": "string"
    },
    "entry_fee": {
      "type": "number"
    },
    "capacity": {
      "type": "integer"
    },
    "registered_count": {
      "type": "integer",
      "default": 0
    },
    "sanctioned_by": {
      "type": "string",
      "default": "CLDSA"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "screening",
        "live",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "image_url": {
      "type": "string"
    },
    "safety_crew_required": {
      "type": "integer",
      "default": 0
    },
    "support_vessels": {
      "type": "integer",
      "default": 0
    },
    "minimum_age": {
      "type": "integer",
      "default": 16
    }
  },
  "required": [
    "name",
    "swim_type",
    "start_date",
    "distance_km",
    "location"
  ]
}
{
  "name": "Swimmer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non_binary",
        "prefer_not"
      ]
    },
    "nationality": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "weight_kg": {
      "type": "number"
    },
    "height_cm": {
      "type": "number"
    },
    "wetsuit": {
      "type": "boolean",
      "default": false
    },
    "emergency_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "notify_start": {
            "type": "boolean"
          },
          "notify_finish": {
            "type": "boolean"
          },
          "notify_alert": {
            "type": "boolean"
          }
        }
      }
    },
    "medical_conditions": {
      "type": "string"
    },
    "medications": {
      "type": "string"
    },
    "allergies": {
      "type": "string"
    },
    "cold_water_experience_years": {
      "type": "number",
      "default": 0
    },
    "previous_channel_swims": {
      "type": "integer",
      "default": 0
    },
    "longest_swim_km": {
      "type": "number",
      "default": 0
    },
    "coldest_water_swum_c": {
      "type": "number"
    },
    "acclimatization_level": {
      "type": "string",
      "enum": [
        "none",
        "beginner",
        "intermediate",
        "experienced",
        "elite"
      ],
      "default": "beginner"
    },
    "screening_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_review",
        "cleared",
        "conditional",
        "deferred"
      ],
      "default": "pending"
    },
    "screening_risk_score": {
      "type": "number",
      "default": 0
    },
    "screening_risk_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "swim_pr_5km_minutes": {
      "type": "number"
    },
    "club": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "dob"
  ]
}
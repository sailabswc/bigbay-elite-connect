{
  "name": "LiveMetric",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "registration",
        "revenue",
        "safety",
        "conditions"
      ],
      "default": "registration"
    },
    "value": {
      "type": "number",
      "default": 0
    },
    "unit": {
      "type": "string"
    },
    "decimals": {
      "type": "integer",
      "default": 0
    },
    "format": {
      "type": "string",
      "enum": [
        "number",
        "currency"
      ],
      "default": "number"
    },
    "delta": {
      "type": "number",
      "default": 0
    },
    "trend": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "default": "flat"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "source": {
      "type": "string",
      "default": "simulated"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string"
    },
    "room_member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    },
    "attachment_type": {
      "type": "string",
      "enum": [
        "image",
        "file"
      ]
    },
    "attachment_name": {
      "type": "string"
    },
    "system": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "room_id",
    "sender_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.room_member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.room_member_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "data.sender_id": "{{user.id}}"
    },
    "delete": {
      "data.sender_id": "{{user.id}}"
    }
  }
}